diff --git a/src/WallpaperEngine/WebBrowser/CEF/WebProperties.h b/src/WallpaperEngine/WebBrowser/CEF/WebProperties.h
--- /dev/null
+++ b/src/WallpaperEngine/WebBrowser/CEF/WebProperties.h
@@ -0,0 +1,69 @@
+#pragma once
+
+#include <charconv>
+#include <map>
+#include <string>
+#include <nlohmann/json.hpp>
+
+namespace WallpaperEngine::WebBrowser::CEF {
+inline nlohmann::json webProperties (
+    const nlohmann::json& definitions, const std::map<std::string, std::string>& overrides
+) {
+    auto result = nlohmann::json::object ();
+    if (!definitions.is_object ()) return result;
+    for (const auto& [name, definition] : definitions.items ()) {
+        if (!definition.is_object () || !definition.contains ("value")) continue;
+        auto property = definition;
+        const auto override = overrides.find (name);
+        if (override != overrides.end ()) {
+            const auto type = definition.value ("type", "");
+            const auto& value = override->second;
+            if (type == "bool") {
+                property["value"] = value == "1" || value == "true";
+            } else if (type == "slider") {
+                double parsed = 0.0;
+                const auto* begin = value.data ();
+                const auto* end = begin + value.size ();
+                const auto [ptr, ec] = std::from_chars (begin, end, parsed);
+                if (ec == std::errc () && ptr == end) {
+                    property["value"] = parsed;
+                }
+            } else if (type == "combo") {
+                if (definition.contains ("options") && definition["options"].is_array ()) {
+                    for (const auto& option : definition["options"]) {
+                        if (!option.is_object () || !option.contains ("value")) continue;
+                        const auto& candidate = option["value"];
+                        if ((candidate.is_string () ? candidate.get<std::string> () : candidate.dump ()) == value) {
+                            property["value"] = candidate;
+                            break;
+                        }
+                    }
+                }
+            } else {
+                property["value"] = value;
+            }
+        }
+        result[name] = std::move (property);
+    }
+    return result;
+}
+
+inline std::string webPropertyScript (const nlohmann::json& properties) {
+    if (properties.empty ()) return "";
+    return R"JS((function () {
+        const properties = )JS" + properties.dump (-1, ' ', true) + R"JS(;
+        function deliver() {
+            const listener = window.wallpaperPropertyListener;
+            if (!listener || typeof listener.applyUserProperties !== "function") return false;
+            listener.applyUserProperties(properties);
+            return true;
+        }
+        if (!deliver()) {
+            let attempts = 0;
+            const timer = setInterval(function () {
+                if (deliver() || ++attempts >= 100) clearInterval(timer);
+            }, 100);
+        }
+    })(); )JS";
+}
+}
